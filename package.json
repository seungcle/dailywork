{
  "name": "dailywork",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed:dev": "tsx --env-file-if-exists=.env.local scripts/seed-dev.ts",
    "admin:create": "tsx --env-file-if-exists=.env.local scripts/create-admin.ts",
    "db:migrate:prod": "tsx --env-file=.env.deploy scripts/migrate.ts",
    "admin:create:prod": "tsx --env-file=.env.deploy scripts/create-admin.ts",
    "deploy:check": "tsx --env-file=.env.deploy scripts/deploy-check.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "postgres": "^4.1.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
