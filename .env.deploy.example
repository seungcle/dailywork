# 운영 DB 작업용 값. .env.deploy로 복사해서 채운다(Git에 올라가지 않음).
# npm run db:migrate:prod / admin:create:prod / deploy:check 에서만 읽고, 로컬 앱 실행에는 쓰이지 않는다.

# Supabase > Connect > Transaction pooler (포트 6543)
DATABASE_URL=

# Supabase > Connect > Session pooler (포트 5432)
MIGRATION_DATABASE_URL=

# openssl rand -base64 32 로 만든 운영 전용 키. Vercel에도 같은 값을 넣는다.
DATA_ENCRYPTION_KEY=

