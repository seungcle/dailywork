# ── 필수 ─────────────────────────────────────────────
# 로컬: docker compose up -d 로 띄운 DB
# 운영: Supabase > Connect > Transaction pooler(포트 6543) 연결 문자열
DATABASE_URL=postgres://dailywork:dailywork_local_only@127.0.0.1:54329/dailywork

# 계좌번호·주민등록번호 암호화 키 (32바이트 base64)
# 생성: openssl rand -base64 32
# 분실하면 암호화된 정보를 복구할 수 없으니 운영 키는 별도로 안전하게 보관한다.
DATA_ENCRYPTION_KEY=

# ── 선택 ─────────────────────────────────────────────
# 주민등록번호 수집은 필요성과 법적 처리 근거를 확인한 뒤에만 true로 바꾼다.

# 마이그레이션 전용 연결 문자열. Supabase에서는 Session pooler(포트 5432) 또는 Direct 연결을 사용한다.
# 비워두면 DATABASE_URL을 사용한다.
MIGRATION_DATABASE_URL=

# npm run db:seed:dev 가 만드는 로컬 전용 관리자 비밀번호
DEV_ADMIN_PASSWORD=
